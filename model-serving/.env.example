# One .env for the whole lab: control plane (Node), serving nodes, trainer and
# load generator (Python) all read this file. `make install` copies it to .env.

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Any MongoDB 7.0+ REPLICA SET works: transactions and change streams need one.
# Atlas (M0 included) is always a replica set. Atlas Flex clusters do NOT
# support change streams, so serving nodes cannot run against Flex.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=model_serving

# Optional: a separate, restricted user for the serving nodes. When empty,
# serving nodes use MONGODB_URI. See README -> "Least privilege" for the role.
SERVING_MONGODB_URI=

# Connection metadata used by MongoDB DevRel to measure article reach.
# Naming convention: devrel-MEDIUM-PRIMARY-SECONDARY-OPTIONAL
# Set in code on every MongoClient (Node and Python) and overrides any
# appName in the URI.
APP_NAME=devrel-article-changestreams-model-serving

# ---------------------------------------------------------------------------
# Control plane (Node)
# ---------------------------------------------------------------------------
CONTROL_PLANE_PORT=4030

# CORS
#   "*"                                  -> allow any origin
#   "localhost"                          -> allow any http://localhost:PORT (dev)
#   "https://app.example.com,https://x"  -> comma-separated allow-list
CORS_ORIGIN=localhost

# Background drift/contract check. Writes to the `alerts` collection.
# 0 disables it.
MONITOR_INTERVAL_SEC=60

# ---------------------------------------------------------------------------
# Artifacts
# ---------------------------------------------------------------------------
# gridfs -> weights stored in the cluster (bucket "artifacts")
# file   -> weights written under ARTIFACT_DIR, a stand-in for object storage
ARTIFACT_STORE=gridfs
ARTIFACT_DIR=./artifacts

# ---------------------------------------------------------------------------
# Serving nodes (Python)
# ---------------------------------------------------------------------------
# Comma-separated deployment ids each node serves.
SERVING_DEPLOYMENTS=churn-classifier/prod

# false -> missing/null features are imputed with 0 and the request is served
#          (what most stacks do by default; the input-contract check is how
#          the platform notices)
# true  -> missing/null features are rejected with 422
STRICT_INPUTS=false
