# Server
PORT=4020

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=support_chatbot

# Connection metadata used by MongoDB DevRel to measure article reach.
# Naming convention: devrel-MEDIUM-PRIMARY-SECONDARY-OPTIONAL
# This is set in code (db.js) and overrides any appName in the URI.
APP_NAME=devrel-article-vectorsearch-support-agent

# Voyage AI via the MongoDB-managed gateway (recommended).
#
# Create a "Model API Key" in
#   Atlas -> Organization -> Access Manager -> Model API Keys
# The key is prefixed `al-...`.
#
# If you'd rather call Voyage directly, set:
#   VOYAGE_BASE_URL=https://api.voyageai.com/v1
# and use a `pa-...` key from https://dash.voyageai.com.
VOYAGE_BASE_URL=https://ai.mongodb.com/v1
VOYAGE_API_KEY=al-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VOYAGE_EMBEDDING_MODEL=voyage-3.5
VOYAGE_RERANK_MODEL=rerank-2

# Atlas Search / Vector Search index names (created via scripts/create-indexes.js)
ATLAS_SEARCH_INDEX=kb_articles_search
ATLAS_VECTOR_INDEX=kb_chunks_vector
ATLAS_TICKETS_INDEX=tickets_vector

# LLM. Two models: one for generation (streamed answer), one for the
# condense/classify step. The condense call is short, structured and runs on
# every turn -- a smaller model keeps per-turn latency and cost down.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o-mini
LLM_CONDENSE_MODEL=gpt-4o-mini

# CORS
#   "*"                                  -> allow any origin (default)
#   "localhost"                          -> allow any http://localhost:PORT (handy in dev)
#   "https://app.example.com,https://x"  -> comma-separated allow-list
CORS_ORIGIN=localhost
